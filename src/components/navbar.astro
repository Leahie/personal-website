---
import CircuitChip from './circuitchip.astro';
import {Image} from 'astro:assets';

import Hamburger from './hamburger.astro';
import navLinks from '@/data/nav.json'
import icon from '@/assets/Icon_small.png'

const page = new URL(Astro.request.url).pathname;

---
<!-- source https://github.com/annaahsu/website/blob/main/src/components/navbar.astro -->

<nav>
    <div class="nav-mobile">
        <div class="logo">
            <a href="/">
                <div class="logo-items" >
                    <div class="logo-image">
                        <!-- <Image src={icon} alt="Logo" width={80} height={80} densities={[1.5, 2, 3]}  /> -->
                    </div>
                    <div class="logo-chip">
                        <CircuitChip show={true} nav={true} />
                    </div>
                </div>
            </a>
        </div>
        <span class="navbar-toggle" id="js-navbar-toggle" onclick="document.getElementById('js-menu').classList.toggle('on')">
            <Hamburger />
        </span>
    </div>
    <div class="navlinks" id="js-menu">
        {
            navLinks.map(({ name, link }) => (
                <a class={page.includes(link) ? "active link" : "link"} href={link}>
                {name}
                </a>
            ))
        }
    </div>
</nav>

<style lang="scss">
    .logo-items{
        display:grid;
        grid-template-areas: "overlay";
        width: 170px;
        height: 100px;

        > div{
            grid-area: overlay;
        }
    }
    .logo-chip{
        justify-self: start;
        align-self: start;

        translate: -45px -30px;
        

        width:170px;
        height: 100px;
    }

    .logo-image{
        justify-self: start;
        align-self: start;

        translate: 10px 30px;
        z-index: 1;

        
        width: 70px;
        height: 70px;
    }

    nav{
        position: fixed;
        background-color: var(--pale);
        color: inherit;
        display: flex;
        flex-direction:column;
        padding: 32px;
        max-width: 964px;
        width: 100%;
        z-index: 999;

        @media (max-width: 350px) {
            padding: 32px 16px;
        }
    }

    .logo{
        a{
            color: var(--black);
        }
    }

    .nav-mobile{
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .navlinks{
        display:none;
        font-weight: 500;
        
    }

    .navbar-toggle{
        display: inline-flex;
    }

    .navbar-toggle:hover {
        cursor: pointer;
    }

    @media (max-width: 800px) {
    nav {
        gap: 32px;
        }

        .active {
        font-weight: bold;
        }

        .link {
        font-size: 20px;
        width: 100%;
        text-align: center;
        }
    }

    @media (min-width: 800px) {
        nav {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        }

        .navlinks {
        display: flex;
        gap: 32px;
        }

        .link {
        &::after {
            background: var(--light);
            content: "";
            width: 0;
            position: absolute;
            top: 22px;
            left: 0;
            right: 0;
            height: 2px;
            opacity: 0;
            transition: 0.2s;
        }

        &:hover::after {
            opacity: 1;
            width: 100%;
        }
        }

        .active::after {
        opacity: 1;
        width: 100%;
        }

        .navbar-toggle {
        display: none;
        }
    }

    .on {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        overflow: hidden;

        min-height: 100vh;
    }

    [astro-icon] {
        color: var(--med);
    }

    a {
        display: inline-block;
        position: relative;
        transition: 0.2s;
        color: var(--med);
        text-decoration: none;
        box-shadow: none;
        padding: 0;
        font-weight: inherit;
    }

    a:hover {
        background: none;
    }

    @media (prefers-reduced-motion: reduce) {
        a {
        transition: none;
        }
    }
</style>

