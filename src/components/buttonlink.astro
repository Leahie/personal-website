---
export interface Props {
    href: string;
    variant?: 'light' | 'dark';
}

const { href, variant = 'light' } = Astro.props;

---

<a {href} class:list={['button-link', variant]}>
    <slot />
</a>

<style lang="scss">
    .button-link{
        text-decoration: none;
        font-size: 17px;
        font-weight: 500;
        padding: 8px 16px;
        border-radius: 10px;
        transition: background-color 0.3s ease-in-out, color 0.3s ease-in-out;
        height: fit-content;

        &.light {
            color: var(--med);
            background-color: var(--pale);

            &:hover {
                background-color: var(--light);
                color: var(--white);
            }
        }

        &.dark {
            color: var(--pale);
            background-color: var(--med);

            &:hover {
                background-color: var(--light);
                color: var(--white);
            }
        }
    }
</style>
