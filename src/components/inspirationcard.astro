---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import fallbackCard from '@/assets/home_card.png';
import Link from '@lucide/astro/icons/arrow-up-right';

interface Props {
  item: {
    title: string;
    image?: string;
    date?: string;
    year?: string;
    subtitle?: string;
    desc?: string;
    url?: string;
  };
}

const { item } = Astro.props;

// Explicit globs — keep Portfolio + Research (avoid matching junk / broken public links)
const assetModules = {
  ...import.meta.glob<{ default: ImageMetadata }>(
    '../assets/Portfolio/**/*.{jpg,jpeg,png,JPG,JPEG,PNG,webp,WEBP}',
    { eager: true }
  ),
  ...import.meta.glob<{ default: ImageMetadata }>(
    '../assets/Research/**/*.{jpg,jpeg,png,JPG,JPEG,PNG,webp,WEBP}',
    { eager: true }
  ),
};

/** Map "Portfolio/Older-Works/Obser1.jpg" → ImageMetadata */
const assetsByPath: Record<string, ImageMetadata> = {};
for (const [key, mod] of Object.entries(assetModules)) {
  const k = key.replace(/\\/g, '/');
  const marker = '/assets/';
  const idx = k.lastIndexOf(marker);
  if (idx === -1) continue;
  const rel = k.slice(idx + marker.length); // e.g. Portfolio/Older-Works/Obser1.jpg
  const meta = (mod as { default: ImageMetadata }).default ?? (mod as ImageMetadata);
  assetsByPath[rel] = meta;
}

function resolveImage(imagePath?: string): ImageMetadata {
  if (!imagePath) return fallbackCard;

  const normalized = imagePath
    .replace(/\\/g, '/')
    .replace(/^\/+/, '')
    .replace(/^src\//, '')
    .replace(/^assets\//, '');

  return assetsByPath[normalized] ?? fallbackCard;
}

const imgSrc = resolveImage(item.image);
const date = item.date || item.year || '';
const subtitle = item.subtitle || item.desc || '';
const hasUrl = Boolean(item.url);
const cardClass = ['inspiration-card', hasUrl && 'inspiration-card--link']
  .filter(Boolean)
  .join(' ');
const cardStyle = `--card-ar: ${imgSrc.width} / ${imgSrc.height}`;
---
<div class="card">
  <!-- Top-left contact pads -->
    <svg class="card-pads" viewBox="0 0 48 18" aria-hidden="true">
      <circle cx="7" cy="9" r="5" />
      <circle cx="22" cy="9" r="2" />
      <circle cx="35" cy="9" r="2" />
    </svg>
     { hasUrl && 
    <div class="card-pads-container">
      <Link width="12" height="12" stroke-width="3"/>
    </div>
    }

  <!-- Bottom circuit trace: full width from right, then down -->
  <svg class="card-trace" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
    <path d="M 100 6 H 0 V 20" fill="none" vector-effect="non-scaling-stroke" />
  </svg>

  {
    hasUrl ? (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class={cardClass}
        style={cardStyle}
      >
        <Image
          src={imgSrc}
          alt={item.title || ''}
          class="inspiration-card-img"
          width={800}
          sizes="(max-width: 600px) 100vw, 450px"
          loading="lazy"
          decoding="async"
        />
        <div class="inspiration-card-shade" aria-hidden="true" />
        <div class="card-meta">
          <h3>{item.title}</h3>
          {date && <p class="card-date">{date}</p>}
          {subtitle && <p class="card-subtitle">{subtitle}</p>}
        </div>
      </a>
    ) : (
      <div class={cardClass} style={cardStyle}>
        <Image
          src={imgSrc}
          alt={item.title || ''}
          class="inspiration-card-img"
          width={800}
          sizes="(max-width: 600px) 100vw, 450px"
          loading="lazy"
          decoding="async"
        />
        <div class="inspiration-card-shade" aria-hidden="true" />
        <div class="card-meta">
          <h3>{item.title}</h3>
          {date && <p class="card-date">{date}</p>}
          {subtitle && <p class="card-subtitle">{subtitle}</p>}
        </div>
      </div>
    )
  }
</div>

<style>
  .card {
    position: relative;
    padding: 30px 5px 15px;
    background-color: var(--white);
    box-shadow: var(--photodrop);
  }

  .card:has(.inspiration-card--link) {
    transition: transform 0.3s ease;
    cursor: pointer;
  }

  .card:has(.inspiration-card--link):hover {
    transform: scale(1.04);
  }

  .card-pads-container {
    position: absolute;
    top: 7px;
    right: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    padding: 8px;
    color: var(--pale);
    background-color: var(--light);
    border-radius: 50%;
  }

  .card-pads-container :global(svg) {
    display: block;
    flex-shrink: 0;
  }

  .card-pads {
    position: absolute;
    top: 4px;
    left: 8px;
    width: 48px;
    height: 18px;
    pointer-events: none;
    z-index: 1;
  }

  .card-pads circle {
    fill: var(--light);
    stroke: var(--med);
    stroke-width: 0;
  }

  .card-trace {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 98px;
    height: 7px;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }

  .card-trace path {
    stroke: var(--light);
    stroke-width: 1.5;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .inspiration-card {
    position: relative;
    display: block;
    width: 100%;
    min-width: 220px;
    height: auto;
    aspect-ratio: var(--card-ar, 1 / 1);
    overflow: hidden;
    border-radius: 1px;
    text-decoration: none;
    background: var(--med);
    border-radius: 10px;

  }

  .inspiration-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .inspiration-card--link .inspiration-card-img {
    filter: blur(1px);
    transform: scale(1.02);
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .card:hover .inspiration-card--link .inspiration-card-img,
  .card:focus-within .inspiration-card--link .inspiration-card-img {
    filter: blur(0);
    transform: scale(1);
  }

  .inspiration-card-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.35) 45%,
      rgba(0, 0, 0, 0.15) 90%,
      transparent 100%
    );
    transition: opacity 0.3s ease;
  }

  .card-meta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.1rem 1.15rem;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .card:hover .inspiration-card-shade,
  .card:hover .card-meta,
  .card:focus-within .inspiration-card-shade,
  .card:focus-within .card-meta {
    opacity: 0;
  }

  .card-meta h3,
  .card-meta .card-date,
  .card-meta .card-subtitle {
    margin: 0;
    color: var(--white);
  }

  .card-meta h3 {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .card-meta .card-date {
    font-size: 0.8rem;
    opacity: 0.9;
  }

  .card-meta .card-subtitle {
    font-size: 0.85rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    color: var(--white);
  }
</style>