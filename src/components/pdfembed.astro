---
export interface Props {
  src: string;
  title: string;
  label?: string;
}

const { src, title, label = 'Open PDF' } = Astro.props;
---

<div class="pdf-embed">
  <iframe
    class="pdf-embed-frame"
    src={src}
    title={title}
  ></iframe>
  <a
    class="pdf-embed-link"
    href={src}
    target="_blank"
    rel="noopener noreferrer"
  >
    {label}
  </a>
</div>

<style lang="scss">
  .pdf-embed {
    margin-top: 1rem;
  }

  .pdf-embed-frame {
    display: block;
    width: 100%;
    height: 600px;
    border: none;
    border-radius: 8px;
  }

  .pdf-embed .pdf-embed-link {
    display: none;
  }

  /* Touch devices: Safari PDF-in-iframe doesn't scroll — link instead */
  @media (hover: none) and (pointer: coarse) {
    .pdf-embed-frame {
      display: none;
    }

    .pdf-embed .pdf-embed-link {
      display: inline-flex;
    }
  }
</style>
