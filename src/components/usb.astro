---
interface Props {
  project: {
    title: string;
    description: string;
    url: string;
    slug: string;
    x: string;
    y: string;
    color: string;
    number: string;
  };
  index: number;
}
const { project, index } = Astro.props;
const detailHref = `/projects/${project.slug}`;
---
<div 
    class="usb-node" 
    style={`top: ${project.y}; left: ${project.x}; --usb-color: ${project.color}; --delay: ${0.5 + index * 0.15}s;`}
>
    <a href={detailHref} class="usb-link">
      <svg 
          class="usb-icon"
          viewBox="0 0 144.47 403.57" 
          xmlns="http://www.w3.org/2000/svg"
      >
          <g transform="rotate(180 72.235 201.785)">
              <g transform="translate(-225.26 -298.48)">
                  <rect id="usb-tip" fill="#dcdde1" height="54.286" width="65.646" y="324.99" x="264.67" />
                  <rect id="usb-body" fill="var(--usb-color)" height="294.29" width="91.429" y="381.25" x="251.78" rx="8" />
                  <g id="usb-details" transform="translate(-1.2458 .31607)" fill="#ffffff">
                      <rect height="9.732" width="11.769" y="342.63" x="277.89" />
                      <rect height="9.732" width="11.769" y="341.89" x="307.82" />
                  </g>
              </g>
          </g>

          <g class="label-group">
              <rect class="number-box" x="37.5" y="140" width="70" height="60" rx="6" />
              <text class="chip-label" x="72.23" y="168" text-anchor="middle" dominant-baseline="central">
                {project.number}
              </text>
          </g>
      </svg>
    </a>

    <div class="projector-beam"></div>

    <div class="hologram-display">
      <div class="holo-content">
        <h3>{project.title}</h3>
        <p>{project.description}</p>
        <div style="display:flex; gap:10px">
            <a href={detailHref}>Learn More</a>
            <a href={project.url} target="_blank" rel="noopener noreferrer">Link ↗</a>
        </div>
      </div>
    </div>
</div>

<style lang="scss">
  .usb-node {
    position: absolute;
    pointer-events: auto; /* Handles mouse detection initialization */
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transform: translateY(-150px);
    animation: usbFallDown 0.7s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    animation-delay: var(--delay);
  }

  .usb-icon {
    width: 70px;
    height: auto;
    cursor: pointer;
    transition: filter 0.2s ease;
    filter: drop-shadow(4px 6px 4px rgba(0, 0, 0, 0.3));
  }

  .number-box {
    fill: var(--white);
    stroke: rgba(0, 0, 0, 0.1);
    stroke-width: 2;
  }

  .chip-label {
    fill: var(--black);
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 50px;
    font-weight: bold;
  }

  // 1. The Light Cone
  .projector-beam {
    position: absolute;
    top: 190px; 
    width: 140px;
    height: 240px;
    background: linear-gradient(to bottom, var(--usb-color), transparent);
    clip-path: polygon(40% 0, 60% 0, 100% 100%, 0 100%);
    mix-blend-mode: screen;
    
    opacity: 0;
    transform: scaleX(0);
    transform-origin: top center;
    pointer-events: none; /* FIX: Prevents blocking clicks when invisible */
    visibility: hidden;   /* FIX: Completely hides element boundary from browser tracking */
    transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
  }

  .hologram-display {
    position: absolute;
    top: 215px; 
    width: 210px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    z-index: 15;

    pointer-events: none; 
    visibility: hidden;   
    transition: visibility 0.25s;
  }

  .holo-content {
    opacity: 0;
    width: 100%;
    background: rgba(32, 26, 27, 0.85); 
    backdrop-filter: blur(4px);
    border: 1px solid var(--usb-color);
    box-shadow: 0 0 20px rgba(var(--usb-color), 0.2), 
                inset 0 0 12px rgba(var(--usb-color), 0.1);
    padding: 12px;
    border-radius: 6px;
    margin-top: 6px;
    transform: scale(0.96) translateY(5px);
    box-sizing: border-box;

    h3 {
        margin: 0 0 4px 0;
        font-size: 0.95rem;
        color: var(--white);
    }

    p {
        margin: 0 0 8px 0;
        font-size: 0.75rem;
        line-height: 1.3;
        color: var(--white);
    }

    .click-prompt {
      font-size: 0.7rem;
      font-weight: bold;
      color: var(--usb-color);
      text-shadow: 0 0 4px var(--usb-color);
    }
  }

  .usb-node:hover {
    .projector-beam {
      opacity: 0.25;
      transform: scaleX(1);
      pointer-events: auto; /* Activates hover canvas down below */
      visibility: visible;   /* Brings the element layer to life */
    }

    .hologram-display {
      pointer-events: auto; /* Allows navigation and hover inside the box */
      visibility: visible;   
    }

    .holo-content {
      animation: holoManifestCard 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: 0.2s; /* Snappy dropdown display cadence */
    }
     a {
        display: inline-block;
        position: relative;
        transition: 0.2s;
        font-size:12px;
        color: var(--white);
        text-decoration: none;
        box-shadow: none;
        padding: 0;
        font-weight: inherit;
    }

    a:hover {
        background: none;
    }

  }

  @keyframes holoManifestCard {
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes usbFallDown {
    0% {
      transform: translateY(-150px);
      opacity: 0;
    }
    65% {
      transform: translateY(0);
      opacity: 1;
    }
    82% {
      transform: translateY(-12px);
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>