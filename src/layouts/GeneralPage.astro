---
import "../styles/global.scss";
import Head from "@/components/head.astro";
import Navbar from "@/components/navbar.astro";

interface Props {
    title: string;
    permalink: string;
}

const { title, permalink } = Astro.props;
---
<html lang="en">
    <head>
        <Head title={title} permalink={permalink} />
    </head>
    <body>
        <Navbar />
        <main>
            <slot />
        </main>
    </body>
</html>

<style lang="scss">
    main {
        max-width: 900px;
        width: 100%;
        padding: 170px 0px;
        display: flex;
        flex-direction: column;
        margin: 0 20px;
    }
</style>