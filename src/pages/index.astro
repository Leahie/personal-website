---
import Layout from '../layouts/Page.astro';
import {Image} from 'astro:assets';
import homeCard from '@/assets/home_card.png'
import Socials from '@/components/socials.astro';
import CircuitChip from '@/components/circuitchip.astro';
---

<Layout>
	<div style=" display: flex;  position:relative; justify-content: center; align-items: center; height: 100vh
 ">
		<div class="hero-container">

			<div class="hero-underlay"></div>

			<div class="hero">
				<Image src={homeCard}  alt="Main page" />
				<div class="floating-badge">
					<Socials />

				</div>
			</div>
			
			<div class="chip">
				<CircuitChip />
			</div>
		</div>
		

	</div>
</Layout>

<style>
	.hero-container {
		width: 65%;
		position: relative;
		animation: openLayout 1.2s cubic-bezier(0.25, 1, 0.5, 1)  forwards;
	}

	.chip {
		position: absolute;
		top: -110px;
		right: -240px;
		z-index: 1;
		width: 400px;
	}

	.chip :global(.circuit-svg) {
		max-width: none;
		width: 100%;
	}

	.hero-underlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border-radius: 1rem;
		background-color: var(--med); 
		z-index: 1; /* Sits at the very bottom layer */

		animation: popUnderlay 1.3s cubic-bezier(0.25, 1, 0.5, 1) 1.2s forwards;
	}

	.hero {
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		border-radius: 1rem;
		overflow: hidden;
		background-color: var(--pale);
		position: relative;
		z-index: 2; /* Sits securely above the rotated underlay */
		box-shadow: 
			0px 20px 40px rgba(32, 26, 27, 0.35);

		animation: counterRotateHero 1s cubic-bezier(0.25, 1, 0.5, 1) 2.5s forwards;
	}
    .hero img {
        width: 100%;
        height: auto;
        display: block;

    }

	.floating-badge {
        position: absolute;
        
        top: 36%;   /* 30% down from the top edge */
        right: 18%;  /* 25% in from the left edge */
        
        border-radius: 0.5rem;
		padding: 0.2rem 0.5rem;
		display: flex;
		justify-content: center;
		align-items: center;
		background-color: var(--pale);
        box-shadow: inset 0px 0px 50px rgba(138, 126, 114, 0.25);
    }

	@keyframes openLayout {
		0% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(-5deg);
		}
	}
	@keyframes popUnderlay {
		0% {
			transform: scale(1) translate(0, 0);
		}
		100% {
			transform: scale(1.03) translate(20px, -15px);
		}
	}

	@keyframes counterRotateHero {
		0% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(5deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-container,
		.hero-underlay,
		.hero {
			animation: none !important;
		}
		.hero-underlay {
			transform: rotate(-5deg) scale(1.05) translate(20px, -15px);
		}
	}
</style>