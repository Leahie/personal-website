---
import PageLayout from '@/layouts/GeneralPage.astro';
import Tree from '@/assets/Projects.png';
import { Image } from 'astro:assets';

import Usb from '@/components/usb.astro';
import projects from '@/data/projects.json';
---

<PageLayout title="Projects" permalink="/projects">
  <h1>the art</h1>
  <p >Projects that are the fruits of my labor (get it?). Press a usb to learn more about each one!</p>

  <div class="tree-viewport">
    
    <div class="tree-layer">
      <Image 
        src={Tree} 
        alt="Project Tree Visual" 
        class="tree-img"
        densities={[1.5, 2, 3]} 
      />
    </div>

    <div class="interactive-overlay">
      {
        projects.map((project, index) => (
          <Usb project={project} index={index} />
        ))
      }
    </div>
  </div>
</PageLayout>

<style lang="scss">
  .tree-viewport {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 2rem auto 0 auto;
    border-radius: 12px;
    overflow: hidden;
  }

  .tree-layer {
    width: 100%;
    height: auto;
    display: block;
    animation: rattleTree 0.6s cubic-bezier(.36,.07,.19,.97) both;
    animation-delay: 0.1s;
    filter: drop-shadow(10px 10px 2px var(--light));
  }

  .tree-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .interactive-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  // --- KEYFRAMES ---

  @keyframes rattleTree {
    10%, 90% { transform: translate3d(-1px, 0, 0); }
    20%, 80% { transform: translate3d(2px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-3px, 0, 0); }
    40%, 60% { transform: translate3d(3px, 0, 0); }
  }

 
</style>
