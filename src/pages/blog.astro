---
import PageLayout from '@/layouts/GeneralPage.astro';
import TreeTrunk from '@/assets/CV.png'; // 

// Import the React Navigator component
import TrunkNavigator from '@/components/TrunkNavigator.tsx';
import inspirationData from '@/data/inspiration.json';
---

<PageLayout title="Blog" permalink="/blog">
    <h1>the muse</h1>
    
    <div class="blog-stage">

        <TrunkNavigator 
          client:load 
          data={inspirationData} 
          treeImgSrc={TreeTrunk.src} 
        />
    </div>
</PageLayout>

<style lang="scss">
    /* Keeps the overall page content structured cleanly */
    .blog-stage {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 20px;
    }
    
 
</style>