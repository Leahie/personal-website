---
import PageLayout from '@/layouts/GeneralPage.astro';
import Leah from '@/assets/photo.png';
import Icon from '@/assets/Icon.png';
import {Image} from 'astro:assets';
import ButtonLink from '@/components/buttonlink.astro';
import Socials from '@/components/socials.astro';
---

<PageLayout title="About" permalink="/about">
        <h1>the artist</h1>
        <div>
            <div class="about-content">
                <div class="about-media">
                    <div class="about-images">
                        <div class="leah-stack">
                            <div class="leah-photo">
                                <Image src={Leah} alt="Leah" width={300} densities={[1.5, 2, 3]} />
                            </div>
                            <div class="leah-shadow">
                                <Image src={Leah} alt="" width={300} densities={[1.5, 2, 3]} aria-hidden="true" />
                            </div>
                        </div>
                        <div class="bg-icon">
                            <Image src={Icon} alt="icon" width={300} densities={[1.5, 2, 3]} />
                        </div>
                    </div>

                    

                    <div class="about-bar">
                        <Socials />
                        <ButtonLink variant="dark" href="/resume">Resume</ButtonLink>
                    </div>


                </div>
               
                <div class="about-text">
                    <p>
                        Hello, I'm Leah! I'm a student at <a href="https://www.cornell.edu/">Cornell University</a> studying Computer Science and Mathematics. Joining my high school, Thomas Jefferson High School for Science and Technology, <a href="https://tjatc.org/">assistive technology club</a> pushed me down the coding rabbit hole. Now, I'm passionate about creating tech that makes an impact, making my bed everyday, and listening to podcasts that make me laugh. 
                    </p>
                    <p>
                        I believe the most important part about learning is finding people to look up to and being mildly parasocial about them. I love being a fan. I'm inspired by seeing people create cool things and hearing them talk about their work. That's why I talk about how I made my projects in the <a href="/projects">projects</a> tab.
                    </p>
                    <p>
                        I wanted to create a website that is representative of me, so I picked three things important to me: art, technology, and the color green. I hope you enjoy exploring the creative aspects of my website. I'm always down for conversations, so don't be scared to reach out if you want to talk! 
                    </p>
                    </div>
                
            </div>
        </div>
</PageLayout>

<style lang="scss">
    .about-content {
        display: flex;
        align-items: center;
        gap: 3rem;

        p {
            font-size: 18px;
            line-height: 1.6;
            max-width: 600px;
        }
    }

    .about-media {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .about-images {
        display: grid;
        grid-template-areas: "overlay";

        > * {
            grid-area: overlay;
        }
    }

    .leah-stack {
        display: grid;
        grid-template-areas: "overlay";
        /* Room for the -15px / 15px shadow pop-out without spilling onto the bar */
        width: 300;
        overflow: hidden;

        > * {
            grid-area: overlay;
            width: 300px;
            height:400px;
            justify-self: end;
            align-self: start;
        }
    }

    .leah-photo {
        z-index: 3;
    }

    .leah-shadow {
        z-index: 1;
        overflow: hidden;
        box-shadow: var(--cut);
        border-radius: 50%;

        :global(img) {
            transform: translateX(-300px);
            filter: drop-shadow(300px 0px 2px var(--light));
        }

        animation: slideOut 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
        animation-delay: 0.2s;
    }

    .bg-icon {
        z-index: 2;
        justify-self: start;
        align-self: start;
        translate: 45px -80px;
        scale: -.7 .7;
    }

    
	.about-text a {
		text-decoration: none;
		color: var(--med);
		font-weight: 700;
		text-decoration-line: underline;
		text-decoration-thickness: 2.5px;
		text-underline-offset: 4px;
		text-decoration-color: var(--med);
		/* white fill grows left → right on hover */
		background-image: linear-gradient(var(--white), var(--white));
		background-position: 0 0;
		background-repeat: no-repeat;
		background-size: 0% 100%;
		transition: background-size 0.25s cubic-bezier(0.7, 0, 1, 1); /* slow → fast */

		&:hover,
		&:focus-visible {
			background-size: 100% 100%;
		}
	}

    @keyframes slideOut {
        from {
            translate: 0px 0px;
        }
        to {
            translate: -15px 15px;
        }
    }

    .about-bar {
        display: flex;
        gap: 5px;
        margin-top: 10px;
        justify-content: center;
        width: 100%;
    }
    .about-text {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    @media (max-width: 800px) {
        .about-content {
            flex-direction: column;
        }
    }
</style>